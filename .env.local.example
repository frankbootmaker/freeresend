# Next.js
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-to-a-long-random-string

# Postgres (Compose default)
DATABASE_URL=postgresql://freeresend:freeresend@localhost:5436/freeresend
DATABASE_SSL=false

# Platform admin created by POST /api/setup
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme123

# Optional AWS SES (required for SES egress in production)
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Local: allow sending before public DNS matches. Leave unset in production.
SKIP_DNS_VERIFICATION=true

# SMTP submission listener (npm run smtp / compose service smtp)
SMTP_LISTEN_HOST=0.0.0.0
SMTP_LISTEN_PORTS=2525,587
SMTP_PUBLIC_HOST=localhost
SMTP_PUBLIC_PORT=587
SMTP_PUBLIC_PORTS=587,2525
# Optional inbound TLS (portal Configuration defaults to Let’s Encrypt)
# SMTP_TLS_MODE=starttls
# SMTP_TLS_DOMAIN=smtp.example.com
# SMTP_TLS_CHALLENGE=dns-manual
# LETSENCRYPT_STAGING=true
# ACME_EMAIL=ops@example.com
# ISPCONFIG_API_URL=https://panel.example.com:8080/remote/json.php
# ISPCONFIG_USER=
# ISPCONFIG_PASSWORD=
# ISPCONFIG_API_INSECURE=false
# SMTP_TLS_CERT_PATH=/etc/letsencrypt/live/mail.example.com/fullchain.pem
# SMTP_TLS_KEY_PATH=/etc/letsencrypt/live/mail.example.com/privkey.pem

# Optional DigitalOcean DNS
DO_API_TOKEN=
